# Postgres connection string. For local dev, run `npx prisma dev` and copy the printed URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Auth.js - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Required when running in production mode (NODE_ENV=production, e.g. `next start`
# on the deployed server). Not needed for `next dev`.
AUTH_TRUST_HOST="true"

# PAUSED for the prototype phase - auth currently uses email+password (Credentials
# provider in src/lib/auth.ts) instead. Re-enable Google/LinkedIn when moving to
# product; callback URLs to register when that happens:
#   Google:   http://localhost:3000/api/auth/callback/google
#   LinkedIn: http://localhost:3000/api/auth/callback/linkedin
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Gemini API (Google AI Studio) - CURRENTLY ACTIVE: used for CV structuring, matching,
# document generation, and interview guides (src/lib/gemini.ts).
GEMINI_API_KEY=""

# Anthropic API (Claude) - the originally planned provider, not currently wired up.
# Unused unless the code is switched back from src/lib/gemini.ts to Claude.
ANTHROPIC_API_KEY=""

# PAUSED for the prototype phase - src/lib/storage.ts currently writes to
# public/uploads/ on local disk instead. Re-enable R2 (swap storage.ts back to
# the S3 client) when moving to product / deploying somewhere without a
# persistent local disk.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend - transactional email for new job match notifications
RESEND_API_KEY=""

# Postgres connection string. For local dev, run `npx prisma dev` and copy the printed URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Auth.js - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# OAuth apps (Google Cloud Console / LinkedIn Developer Portal), login-only scopes.
# Callback URLs to register:
#   Google:   http://localhost:3000/api/auth/callback/google
#   LinkedIn: http://localhost:3000/api/auth/callback/linkedin
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Anthropic API (Claude) - used for CV structuring, matching, and document generation
ANTHROPIC_API_KEY=""

# Cloudflare R2 (S3-compatible) - stores uploaded CVs and generated PDFs
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
